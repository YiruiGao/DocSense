# Application
APP_NAME=RAG Backend
DEBUG=false
LOG_LEVEL=INFO

# Runtime data paths
# Relative paths are resolved from the repository root.
DATA_DIR=data
UPLOADS_DIR=data/uploads
EVAL_CORPORA_DIR=data/eval_corpora
CHROMA_DIR=data/chroma
CACHE_DIR=data/cache
LOGS_DIR=data/logs

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# OCR
USE_OCR=false
OCR_LANG=chi_sim+eng

# Hugging Face
# Keep true when models are already cached locally or baked into the image.
HF_HUB_OFFLINE=true

# LLM provider: zai or deepseek
LLM_PROVIDER=zai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
LLM_CONTEXT_CHARS_PER_CHUNK=1200

# z.ai
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_ENABLED=true

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_SIZE=1000

# Retrieval
DEFAULT_TOP_K=10
FINAL_TOP_K=3
VECTOR_WEIGHT=0.6
RETRIEVAL_CANDIDATE_MULTIPLIER=5
DUPLICATE_SIMILARITY_THRESHOLD=0.82
RERANK_MIN_RELEVANCE_SCORE=0.05
OVERVIEW_CONTEXT_CHUNKS=4

# Chunking
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP=50

# Reranking
RERANK_MODEL=BAAI/bge-reranker-base
